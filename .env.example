# the demo's settings: cp .env.example .env, then fill in the model API

# an OpenAI-compatible API for LibreChat
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# one model or several, comma separated
DEFAULT_MODELS=
# extra headers to the API as JSON, like {"x-example":"demo"}
OPENAI_API_HEADERS=
